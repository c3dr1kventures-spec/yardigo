# Kopieer dit bestand naar .env (in dezelfde map) en vul de echte waarden in.
# .env zelf staat in .gitignore — komt nooit in git terecht.

# Key ID uit App Store Connect → Users and Access → Integrations → App Store Connect API
ASC_KEY_ID=

# Issuer ID, staat op dezelfde pagina bovenaan
ASC_ISSUER_ID=

# Volledig pad naar de eenmalig gedownloade .p8-sleutel, bv:
# /Users/christian/.appstoreconnect/private_keys/AuthKey_ABCD123456.p8
ASC_KEY_FILEPATH=
